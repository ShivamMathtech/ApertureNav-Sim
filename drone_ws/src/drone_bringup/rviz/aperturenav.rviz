Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Global Options:
    Background Color: 18; 24; 34
    Fixed Frame: world
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Ground
      Enabled: true
    - Class: rviz_default_plugins/RobotModel
      Name: Drone
      Enabled: true
      Description Topic:
        Value: /robot_description
    - Class: rviz_default_plugins/TF
      Name: Frames
      Enabled: true
    - Class: rviz_default_plugins/Path
      Name: Trajectory
      Enabled: true
      Topic:
        Value: /planner/trajectory
    - Class: rviz_default_plugins/Marker
      Name: Aperture
      Enabled: true
      Marker Topic:
        Value: /aperture/marker
    - Class: rviz_default_plugins/Image
      Name: Camera
      Enabled: true
      Topic:
        Value: /aperture/debug_image
    - Class: rviz_default_plugins/PointCloud2
      Name: Depth cloud
      Enabled: false
      Topic:
        Value: /drone/depth/points
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 9
      Pitch: 0.4
      Yaw: 3.8
Window Geometry:
  Width: 1280
  Height: 800
